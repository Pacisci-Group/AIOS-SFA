{
  "name": "@sfa/api",
  "version": "0.1.0",
  "description": "SFA Platform NestJS API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "worker": "node dist/worker.js",
    "worker:dev": "nest start --watch --entryFile worker",
    "seed": "node dist/seed/seed.js",
    "seed:dev": "ts-node -r tsconfig-paths/register src/seed/seed.ts",
    "seed:demo": "node dist/seed/demo/demo-seed.js",
    "seed:demo:dev": "ts-node -r tsconfig-paths/register src/seed/demo/demo-seed.ts",
    "migrate": "node dist/migration/migrate.js",
    "migrate:dev": "ts-node -r tsconfig-paths/register src/migration/migrate.ts",
    "migrate:mailers": "node dist/migration/mailers/import-bigquery-mailers.js",
    "migrate:mailers:dev": "ts-node -r tsconfig-paths/register src/migration/mailers/import-bigquery-mailers.ts",
    "migrate:tickets": "node dist/migration/consolidate-service-tickets.js",
    "migrate:tickets:dev": "ts-node -r tsconfig-paths/register src/migration/consolidate-service-tickets.ts",
    "sync:roles": "node dist/seed/sync-role-templates.js",
    "sync:roles:dev": "ts-node -r tsconfig-paths/register src/seed/sync-role-templates.ts",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:unit": "jest --config ./test/jest-unit.json",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@google-cloud/bigquery": "^8.3.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@sfa/shared": "*",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^5.6.0",
    "inngest": "^4.18.1",
    "ioredis": "^5.11.1",
    "mongoose": "^8.12.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.20.0",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
