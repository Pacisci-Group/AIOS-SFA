# SFA Platform — local development environment
#
# This one file serves both ways of running the stack. Every value below is the
# HOST-MODE value (localhost addresses), because that is what a process running
# on your machine needs. When the app runs inside Docker instead, the `api`
# service in docker-compose.yml overrides the handful of addresses that differ
# (MONGODB_URI, CORS_ORIGIN, REDIS_URL, STORAGE_*) with compose-network ones.
# So: never edit this file to switch modes.
#
#   make infra   Mongo + MinIO + Redis in Docker, API + web on the host
#                (`npm run api:dev` / `npm run web:dev`) — the default dev loop
#   make up      everything in Docker
#
# The two cannot run at once — they both want ports 4000 and 5173.

# MongoDB
# - Local dev (API on host): mongodb://localhost:27017/sfa?directConnection=true
# - Docker Compose overrides this to mongodb://mongo:27017/sfa?directConnection=true
#
# Mongo runs as a single-node replica set (rs0) because the lead-intake pipeline
# needs multi-document transactions, which standalone mongod does not support.
# Keep `directConnection=true` and do NOT add `replicaSet=rs0`: the driver reads
# directConnection first and rejects the combination, and Single topology is what
# stops it rewriting `localhost` to the member's advertised host (`mongo:27017`).
MONGODB_URI=mongodb://localhost:27017/sfa?directConnection=true

# API
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT (change in production)
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Employee invitations (PAC-58)
#
# APP_BASE_URL is the public origin of the WEB app, not the API. It is what the
# invite link in the email is built from, so it must be absolute — an email
# client has no origin to resolve a relative path against. In production set this
# to the real site URL; a wrong value produces links that 404 for every invitee.
APP_BASE_URL=http://localhost:5173
# How long an invite link stays valid (days).
INVITE_EXPIRY_DAYS=7
# Minimum gap between two resends of the same invite (seconds). Per invited user
# — the global rate limits are per IP and would not stop one owner repeatedly
# mailing one invitee.
INVITE_RESEND_COOLDOWN_SECONDS=60
#
# ⚠ Email delivery is NOT implemented yet — `MailService` logs the rendered
# invite (including the link) to the API console instead of sending it. Pick up
# the link from there to walk the flow locally. Because of that, the invite
# response still returns the raw `inviteToken` whenever NODE_ENV is not
# `production`. Both go away when a real transport lands (PAC-58 Scope 1).

# Permissions cache (OPTIONAL).
# Authorization is always resolved from MongoDB (the source of truth). If
# REDIS_URL is set, resolved permission sets are cached in Redis to avoid a DB
# read per request; if unset, the API resolves from MongoDB on every request.
#
# `make infra` / `make up` start a Redis container either way, so uncommenting
# the line below is the whole switch. Both run modes follow it: the compose
# `api` service expands REDIS_URL to redis://redis:6379 when this is set and to
# nothing when it is not, so Docker and host mode never disagree about whether
# caching is on.
# REDIS_URL=redis://localhost:6379
# PERMISSION_CACHE_TTL_SECONDS=300

# Core seed credentials — the platform super admin created by `npm run api:seed:dev`
# (also runs on docker compose up). This is the only login the core seed creates.
SEED_SUPER_ADMIN_EMAIL=admin@sfa.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

# Agency owner — the one login that can administer the tenant. Created by the
# core seed only when BOTH are set, so a deployed environment never silently
# gains an account with a default password.
#
# Set these for the first bring-up of any environment. Without an owner the
# agency has no login that can invite anyone, and there is no bootstrapping out
# of it later: the platform super admin resolves to platform permissions only,
# holds no `agency:*`, and `POST /users/invite` 403s. Re-running the seed with a
# new password is also the supported way to recover a lost owner login.
SEED_AGENCY_OWNER_EMAIL=owner@smithfamily.local
SEED_AGENCY_OWNER_PASSWORD=ChangeMe123!

# Demo seed (`npm run api:seed:demo:dev`) — shared password for the full demo
# agency roster (owner/manager/producers/CRMs/data team). No CRM data in the core seed.
SEED_DEFAULT_PASSWORD=ChangeMe123!

# Object storage (S3-compatible) — document uploads (e.g. deal-audit resolution docs).
# Local dev uses MinIO (via docker compose); the cloud uses DigitalOcean Spaces.
# Uploads use presigned PUT URLs, so the endpoint the URL is signed against must
# be reachable by the browser.
#
# --- Local (API on host, MinIO in Docker via `make dev`) ---
# Console UI: http://localhost:9001.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=sfa-uploads
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
# MinIO needs path-style addressing (true); most cloud providers use virtual-host (false).
STORAGE_FORCE_PATH_STYLE=true
# Optional: sign browser URLs against a different public endpoint than the one the
# API uses internally (docker compose sets this to http://localhost:9000 while the
# containerized API talks to http://minio:9000 — same port, but `minio` does not
# resolve in the browser). Leave unset when they are the same, i.e. when the API
# runs on the host and talks to localhost:9000 directly.
# STORAGE_PUBLIC_URL=
# Presigned URL lifetimes (seconds).
# STORAGE_UPLOAD_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# BigQuery — legacy mailer history (PAC-73)
# ---------------------------------------------------------------------------
# Only the mailer backfill reads these (`npm run api:migrate:mailers:dev`), and
# it is a **production deploy step**, not part of local development: the RTP
# upload and the demo seed both populate a working `mailers` collection without
# GCP. Leave them unset locally.
#
# The source is the base table `Mailer_Test_Alteryx`, not one of the
# `_Parallel` / `_Current` / `_Enriched` views — those exist so users would not
# touch the base table, which is why legacy pointed at one, not because any of
# them is canonical.
# BQ_PROJECT_ID=allstate123
# BQ_DATASET_ID=smartsuite_data
# BQ_MAILERS_TABLE_ID=Mailer_Test_Alteryx
# Service-account key file contents, on a single line.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
# STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
#
# --- Cloud (DigitalOcean Spaces) ---
# STORAGE_ENDPOINT=https://nyc3.digitaloceanspaces.com
# STORAGE_REGION=nyc3
# STORAGE_BUCKET=<your-space-name>
# STORAGE_ACCESS_KEY_ID=<spaces-access-key>
# STORAGE_SECRET_ACCESS_KEY=<spaces-secret-key>
# STORAGE_FORCE_PATH_STYLE=false
# NOTE: configure CORS on the Space to allow PUT/GET from the web app origin.

# SmartSuite -> MongoDB migration (PAC-18). Required to run `npm run migrate[:dev]`.
# Auth: Authorization: Token <SMARTSUITE_API_TOKEN>, Account-Id: <SMARTSUITE_ACCOUNT_ID>.
SMARTSUITE_API_TOKEN=
SMARTSUITE_ACCOUNT_ID=
SMARTSUITE_SOLUTION_ID=
# SMARTSUITE_BASE_URL=https://app.smartsuite.com/api/v1
# Optional table-id overrides (defaults target the Smith Family Agency workspace):
# SMARTSUITE_USERS_TABLE_ID=69422c487eafe925c8e4bbfa
# SMARTSUITE_HOUSEHOLDS_TABLE_ID=6941fa11964c58f31380427c
# SMARTSUITE_CONTACTS_TABLE_ID=6941fb21eea41b87f26cd10d
# SMARTSUITE_LEADS_TABLE_ID=6941fdb1dc9a6d024fd8b505
# SMARTSUITE_QUOTE_RECAPS_TABLE_ID=6941fdb2dc9a6d024fd8bc53
# SMARTSUITE_DEALS_TABLE_ID=6941fdb2dc9a6d024fd8c3a1
# SMARTSUITE_POLICIES_TABLE_ID=6941fc5b08644a5fbf05a781
# SMARTSUITE_DEAL_AUDIT_ITEMS_TABLE_ID=69533b022b0995e027431c02
# SMARTSUITE_DEAL_AUDITS_TABLE_ID=6941fdb2dc9a6d024fd8caef
# SMARTSUITE_AUDIT_TEMPLATES_TABLE_ID=69532d09f018acf38e53443a
# SMARTSUITE_INTERESTED_PARTIES_TABLE_ID=694240c03d897b7099d73340
# SMARTSUITE_PRIOR_INSURANCE_TABLE_ID=69423c25d4f749d1e15c017a
# SMARTSUITE_PRIOR_POLICIES_TABLE_ID=69423e89ea5c9f2798e4bc00
# SMARTSUITE_SERVICE_TICKETS_TABLE_ID=6941fdb3dc9a6d024fd8d23d
# SMARTSUITE_PRODUCER_ASSIGNMENTS_TABLE_ID=695ec3890ac528daf6607fa2
# SMARTSUITE_CRM_ROTATION_TABLE_ID=695ec474897e7b72911f64d7
# SMARTSUITE_TIME_OFF_REQUEST_TABLE_ID=696dd246b1bf4b889f2fb4fa
# Where the reconciliation report JSON is written (default: cwd/migration-report.json):
# MIGRATION_REPORT_PATH=./migration-report.json

# --- Rate limiting (PAC-37) ---
# The public lead-intake routes are the only unauthenticated write surface, so
# their limits are tunable without a deploy. All values are requests per IP.
#
# ⚠ These must be set as REAL environment variables (docker-compose
# `environment:`, or the platform's config) — unlike everything else here, they
# are NOT picked up from this .env file. The @Throttle decorators are evaluated
# when the controller class is imported, which happens before ConfigModule runs
# dotenv. Values left in .env silently fall back to the defaults shown.
# Baseline for every route (per minute / per hour):
# RATE_LIMIT_SHORT=300
# RATE_LIMIT_LONG=3000
# GET /public/lead-form/:token — per minute. Looser than submit on purpose: a
# submitter reloading the form must not get locked out of a page that only shows
# an agency name.
# PUBLIC_FORM_RATE_LIMIT=10
# POST /public/leads/:token — per minute, plus an hourly cap to catch slow drips.
# PUBLIC_INTAKE_RATE_LIMIT=5
# PUBLIC_INTAKE_HOURLY_LIMIT=30

# Base URL the public intake form is served from; share-link URLs are built as
# `${PUBLIC_FORM_BASE_URL}/f/lead/{token}`. Defaults to the local web app.
# PUBLIC_FORM_BASE_URL=http://localhost:5173

# --- Async work: Inngest + email (PAC-58) ---
# All asynchronous work — every outbound email, and every scheduled job — runs
# as an Inngest function served from `src/worker/`. Inngest itself is a
# self-hosted container; locally you run the dev server instead:
#
#   npx inngest-cli@latest dev -u http://localhost:4000/api/inngest
#
# Dev mode. `1` locally: the SDK then talks to the dev server on its default
# port and skips request-signature verification. Set to `0` in every deployed
# environment — without it the SDK infers from NODE_ENV, which is not a signal
# this should hang off, and a client left in dev mode will not verify signatures.
INNGEST_DEV=1
# The self-hosted server's address. Leave unset locally (the SDK finds the dev
# server itself); in deployed environments this is the Inngest droplet, reachable
# only over the VPC.
# INNGEST_BASE_URL=http://10.0.0.5:8288
# Authenticates events we send. Must match the server's --event-key.
# INNGEST_EVENT_KEY=
# Verifies that a request to /api/inngest really came from Inngest. Must match
# the server's --signing-key, and must be hex with an even number of characters
# (`openssl rand -hex 32`).
#
# ⚠ /api/inngest is mounted as raw Express middleware, so none of the seven
# global guards apply to it. This key is its ONLY authentication.
# INNGEST_SIGNING_KEY=

# Whether async work runs inside the API process.
#
# `true` (the default) today: traffic is low and one container is simpler. Set
# to `false` and start the `worker` compose profile to run `dist/worker.js` as
# its own container — the same image, the same modules, an independent scale.
#
# ⚠ Exactly one of the two must serve the functions: if the API runs them inline
# AND a worker container is up, both register under the same Inngest app id and
# whichever synced last wins.
#
# ⚠ Like RATE_LIMIT_* above, this must be a REAL environment variable — it is
# read while the module graph is built, before ConfigModule runs dotenv.
# WORKER_INLINE=false

# ─── Event log (the durable outbox) ──────────────────────────────────────────
# Every event is written to the `eventLog` collection in Mongo *before* it is
# sent to Inngest, and updated once when the run reaches a terminal state. That
# is what makes two things possible that no Inngest backend can offer: recovering
# an event that never reached Inngest at all, and answering "which work failed?"
# from a database the application can actually query.
#
# How long a TERMINAL row is kept, in days. Only terminal rows carry an
# `expiresAt`, so this can never reap a row the sweeper still needs — a stuck
# `pending` row lives until something resolves it. Default 30.
# EVENT_LOG_RETENTION_DAYS=30
# How long a row may sit `pending` before the sweeper re-emits it, in minutes.
#
# ⚠ Must exceed the longest expected run duration of any function. The log does
# not track a `running` state (it would double the write cost to say what the
# terminal write already says), so a legitimately long-running function is
# indistinguishable from a lost one and would be replayed underneath itself.
# Comfortable for email at the default of 15; raise it before adding a function
# that runs longer than that.
# EVENT_LOG_STALE_MINUTES=15

# Resend, the email provider. Unset, the worker falls back to a transport that
# logs instead of sending — which is what makes the local invite flow walkable,
# and what makes a missing key in production a silent catastrophe. It is checked
# by the deploy preflight for exactly that reason.
# RESEND_API_KEY=
# The From header. Always a domain verified in Resend — never an agency's own
# domain, which would fail SPF/DKIM and poison the sending reputation.
# MAIL_DEFAULT_FROM=AgencyOps <notifications@example.com>
# Optional Reply-To.
# MAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# --- Address autocomplete (Google Maps Platform, PAC-60) ---
# ---------------------------------------------------------------------------
# Backs the type-ahead on every address field (New Lead, the policy property
# address, the Sold wizard's escrow card). The key is used ONLY by the API and
# is never sent to the browser — that is the whole reason these calls are
# proxied through `/api/v1/address/*` instead of using Google's own web
# component, which would need a scrapable key on the public intake form.
#
# ⚠ Never name this `VITE_*`. `packages/web/vite.config.ts` loads this file with
# an empty prefix, so a VITE-prefixed key would be inlined into the client
# bundle.
#
# Unset, address autocomplete is simply off: the API answers
# `{ available: false }`, the fields behave exactly as they did before PAC-60,
# and nothing errors. Enable "Places API (New)" on the GCP project, restrict the
# key to that API plus the API server's egress IP (no HTTP-referrer restriction
# — the key never reaches a browser), and set a quota cap. Budgets only alert;
# quotas are the hard stop.
# GOOGLE_MAPS_API_KEY=
# Request timeout in ms. This call sits in the keystroke path, so it is short by
# design — a slow lookup is worse than no lookup. Default 3000.
# GOOGLE_MAPS_TIMEOUT_MS=3000
# Override only for a proxy or a test double. Default https://places.googleapis.com/v1
# GOOGLE_PLACES_BASE_URL=

# ⚠ REAL environment variable only — same @Throttle caveat as the rate-limiting
# section above; a value left here is silently ignored.
# POST /address/* — per minute, per IP. A 250ms debounce yields roughly 6-10
# requests per address typed, so this is several forms a minute per user. The
# real spend ceiling is the quota cap on the Google key, not this.
# ADDRESS_LOOKUP_RATE_LIMIT=120
# POST /public/address/:token/* — per minute and per hour, per IP, on the
# unauthenticated intake form.
# PUBLIC_ADDRESS_RATE_LIMIT=30
# PUBLIC_ADDRESS_HOURLY_LIMIT=200
# Address lookups per share link per rolling day. The layer that actually
# bounds spend: per-IP throttling cannot see one scraped link driven from many
# addresses, and every lookup is billed by Google. Counted on the ShareLink
# document, so unlike its two neighbours this one IS read through normal config
# at request time — but it is kept as a real env var so all four address limits
# are tuned the same way.
# PUBLIC_ADDRESS_LINK_DAILY_LIMIT=500
