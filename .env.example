# SFA Platform — local development environment

# MongoDB
# - Local dev (API on host): mongodb://localhost:27017/sfa
# - Docker Compose overrides this to mongodb://mongo:27017/sfa for the api service
MONGODB_URI=mongodb://localhost:27017/sfa

# API
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT (change in production)
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Seed credentials (run once via npm run api:seed:dev or on docker compose up)
SEED_SUPER_ADMIN_EMAIL=admin@sfa.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_AGENCY_OWNER_EMAIL=owner@smithfamily.local
SEED_AGENCY_OWNER_PASSWORD=ChangeMe123!

# SmartSuite -> MongoDB migration (PAC-18). Required to run `npm run migrate[:dev]`.
# Auth: Authorization: Token <SMARTSUITE_API_TOKEN>, Account-Id: <SMARTSUITE_ACCOUNT_ID>.
SMARTSUITE_API_TOKEN=
SMARTSUITE_ACCOUNT_ID=
SMARTSUITE_SOLUTION_ID=
# SMARTSUITE_BASE_URL=https://app.smartsuite.com/api/v1
# Optional table-id overrides (defaults target the Smith Family Agency workspace):
# SMARTSUITE_USERS_TABLE_ID=69422c487eafe925c8e4bbfa
# SMARTSUITE_HOUSEHOLDS_TABLE_ID=6941fa11964c58f31380427c
# SMARTSUITE_LEADS_TABLE_ID=6941fdb1dc9a6d024fd8b505
# SMARTSUITE_QUOTE_RECAPS_TABLE_ID=6941fdb2dc9a6d024fd8bc53
# SMARTSUITE_DEALS_TABLE_ID=6941fdb2dc9a6d024fd8c3a1
# SMARTSUITE_DEAL_AUDIT_ITEMS_TABLE_ID=69533b022b0995e027431c02
# Where the reconciliation report JSON is written (default: cwd/migration-report.json):
# MIGRATION_REPORT_PATH=./migration-report.json
