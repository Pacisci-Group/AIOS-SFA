# SFA Platform — local development environment

# MongoDB
# - Local dev (API on host): mongodb://localhost:27017/sfa
# - Docker Compose overrides this to mongodb://mongo:27017/sfa for the api service
MONGODB_URI=mongodb://localhost:27017/sfa

# API
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT (change in production)
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Seed credentials (run once via npm run api:seed:dev or on docker compose up)
SEED_SUPER_ADMIN_EMAIL=admin@sfa.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_AGENCY_OWNER_EMAIL=owner@smithfamily.local
SEED_AGENCY_OWNER_PASSWORD=ChangeMe123!
