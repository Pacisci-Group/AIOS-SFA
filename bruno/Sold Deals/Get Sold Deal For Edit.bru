meta {
  name: Get Sold Deal For Edit
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/sold-deals/{{createdSoldDealId}}
  body: none
  auth: inherit
}

headers {
  ~X-Branch-Id: {{branchId}}
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the booked deal in the edit shape", function () {
    const body = res.getBody();
    expect(body.id).to.equal(bru.getVar("createdSoldDealId"));
    expect(body.leadId).to.equal(bru.getVar("createdLeadId"));
    [
      "householdId",
      "householdName",
      "clientName",
      "producerName",
      "soldDate",
      "premium",
      "itemCount",
      "policyCount",
      "policyTypes",
      "dealType",
      "isBundle",
      "policies",
      "contacts",
      "auditStatus",
      "isMigrated",
      "canAddPolicies",
      "addPoliciesBlockedBy",
    ].forEach(function (key) {
      expect(body).to.have.property(key);
    });
  });

  test("the sold date is a calendar date", function () {
    expect(res.getBody().soldDate).to.equal("2026-02-15");
  });

  test("the policies are in the shape the Sold card's edit dialog takes", function () {
    const policies = res.getBody().policies;
    expect(policies).to.have.length(2);
    ["id", "policyType", "carrier", "policyNumber", "premium", "items", "effectiveDate"].forEach(function (key) {
      expect(policies[0]).to.have.property(key);
    });
  });

  test("an app-booked sale whose audit is not submitted can take another policy", function () {
    const body = res.getBody();
    expect(body.isMigrated).to.equal(false);
    expect(body.canAddPolicies).to.equal(true);
    expect(body.addPoliciesBlockedBy).to.equal(null);
  });

  test("exposes no internals", function () {
    const body = res.getBody();
    expect(body).to.not.have.property("agencyId");
    expect(body).to.not.have.property("branchId");
    expect(body).to.not.have.property("submissionToken");
    expect(body).to.not.have.property("policyAdditionTokens");
    expect(body).to.not.have.property("legacySmartSuiteId");
  });
}

docs {
  # GET /sold-deals/:id — the Edit sale page (PAC-104)

  Backs `/sold/:id/edit`, reached from **Edit sale** on the Lead Detail Sold
  card. Returns the booked deal, the policies it holds, and whether it can take
  another policy right now.

  - **Module:** `deal_audits` (must be enabled for the agency)
  - **Permission:** `deal_audits:read` (the controller's class gate)
  - **Data scope:** `own` sees only deals they sold; `branch` their branch;
    `agency` everything. Outside scope is a **404**, never a 403.

  ## Response `200`
  | field                | type                     | notes |
  |----------------------|--------------------------|-------|
  | id                   | string                   | |
  | leadId               | string \| null           | `null` on a deal the migration could not link |
  | householdId          | string \| null           | |
  | householdName        | string \| null           | |
  | clientName           | string                   | |
  | producerName         | string \| null           | |
  | soldDate             | `YYYY-MM-DD` \| null     | a calendar date — what a date input holds |
  | premium / itemCount / policyCount | number      | the deal's stored roll-ups |
  | policyTypes          | string[]                 | canonical labels |
  | dealType             | string                   | `Auto` / `Home` / `Bundle` / `Other` |
  | isBundle             | boolean                  | |
  | policies             | `LeadDetailPolicy[]`     | same shape as `GET /leads/:id` → `deal.policies`, so the Sold card's edit dialog works unchanged |
  | contacts             | `SoldHouseholdContact[]` | the defensive-driver picker, for adding a policy |
  | auditStatus          | `Not Submitted` \| `Pending` \| `Pass` \| `Fail` \| null | the furthest any of the deal's audits has got; `null` when none was generated |
  | isMigrated           | boolean                  | imported from SmartSuite |
  | canAddPolicies       | boolean                  | |
  | addPoliciesBlockedBy | `audit_submitted` \| `no_lead` \| `no_household` \| null | why not |

  ## Errors
  - `401 Unauthorized` — missing/expired access token.
  - `403 Forbidden` — `deal_audits` disabled, or no `deal_audits:read`.
  - `404 Not Found` — unknown or malformed id, a deal outside the caller's
    scope, or a **company transfer**. A transfer has no lead, its uploads are
    keyed on a household, and it is corrected from the CRM ticket it was
    recorded on — so it is deliberately not reachable here.

  ## Run order
  Needs `createdSoldDealId` from `Create Sold Deal` (seq 7). Runs after
  `Get Lead (Deal Totals After Patch)` (seq 13), whose hard-coded totals the
  requests below would otherwise change.
}
