meta {
  name: Add Policies To Sold Deal (Duplicate Number)
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/sold-deals/{{createdSoldDealId}}/policies
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  ~X-Branch-Id: {{branchId}}
}

body:json {
  {
    "submissionToken": "bruno-add-duplicate-{{soldPolicyNumber}}",
    "policies": [
      {
        "policyType": "Auto",
        "effectiveDate": "2026-02-01",
        "carrier": "Allstate",
        "policyNumber": "{{soldPolicyNumber}}",
        "premium": 100.00,
        "itemCount": 1,
        "newBusinessApplication": {
          "key": "{{nbaDocumentKey}}",
          "filename": "new-business-application.pdf",
          "contentType": "application/pdf",
          "size": 2048
        },
        "priorInsurance": { "none": true },
        "cancellation": { "cancelled": false }
      }
    ]
  }
}

tests {
  test("returns 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  # POST /sold-deals/:id/policies — a number already on the sale (PAC-104)

  Adds a policy whose number is the Auto policy `Create Sold Deal` (seq 7)
  already put on this sale, under a fresh token.

  - **Module:** `deal_audits` · **Permission:** `deal_audits:write`

  ## Expected
  `400`. The whole-batch rule on create only sees the rows in one request; this
  check compares against the policies the deal **already** holds. Without it the
  policy would be added twice and its premium double-counted on the Sold
  scorecard.
}
