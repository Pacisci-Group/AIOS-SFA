meta {
  name: Create Sold Deal
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/sold-deals
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  ~X-Branch-Id: {{branchId}}
}

body:json {
  {
    "leadId": "{{createdLeadId}}",
    "soldDate": "2026-02-15",
    "submissionToken": "{{soldSubmissionToken}}",
    "policies": [
      {
        "policyType": "Auto",
        "effectiveDate": "2026-02-01",
        "carrier": "Allstate",
        "policyNumber": "{{soldPolicyNumber}}",
        "premium": 1200.10,
        "itemCount": 2,
        "newBusinessApplication": {
          "key": "{{nbaDocumentKey}}",
          "filename": "new-business-application.pdf",
          "contentType": "application/pdf",
          "size": 2048
        },
        "discounts": {
          "drivewise": true,
          "priorInsuranceDiscount": true,
          "defensiveDriver": {
            "selected": true,
            "drivers": [
              {
                "name": "Dana Driver",
                "attachment": {
                  "key": "{{soldDocumentKey}}",
                  "filename": "dana-certificate.pdf",
                  "contentType": "application/pdf",
                  "size": 2048
                }
              },
              {
                "name": "Sam Second",
                "attachment": {
                  "key": "{{soldDocumentKey}}",
                  "filename": "sam-certificate.pdf",
                  "contentType": "application/pdf",
                  "size": 2048
                }
              }
            ]
          },
          "studentDiscount": {
            "selected": true,
            "attachment": {
              "key": "{{soldDocumentKey}}",
              "filename": "transcript.pdf",
              "contentType": "application/pdf",
              "size": 2048
            }
          }
        },
        "priorInsurance": {
          "none": false,
          "carrier": "Geico",
          "agentName": "Jamie Prior",
          "attachment": {
            "key": "{{soldDocumentKey}}",
            "filename": "declarations-page.pdf",
            "contentType": "application/pdf",
            "size": 2048
          }
        },
        "cancellation": {
          "cancelled": true,
          "effectiveDate": "2026-02-10",
          "cancelledBy": "SFA staff",
          "cancelledByUserId": "{{soldStaffUserId}}"
