meta {
  name: Add Policies To Sold Deal
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/sold-deals/{{createdSoldDealId}}/policies
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  ~X-Branch-Id: {{branchId}}
}

body:json {
  {
    "submissionToken": "{{soldAdditionToken}}",
    "policies": [
      {
        "policyType": "Umbrella",
        "effectiveDate": "2026-02-01",
        "carrier": "Allstate",
        "policyNumber": "{{soldPolicyNumberUmbrella}}",
        "premium": 150.00,
        "itemCount": 1,
        "newBusinessApplication": {
          "key": "{{nbaDocumentKey}}",
          "filename": "new-business-application.pdf",
          "contentType": "application/pdf",
          "size": 2048
        },
        "priorInsurance": { "none": true },
        "cancellation": { "cancelled": false }
      }
    ]
  }
}

script:pre-request {
  // Fresh per run. Digits only for the policy number: the carrier is Allstate,
  // whose seeded rule is digits-only (PAC-56 #20). Offset from the two numbers
  // `Create Sold Deal` already put on this sale.
  if (!bru.getVar("soldAdditionToken")) {
    bru.setVar("soldAdditionToken", "bruno-add-" + Date.now());
    bru.setVar(
      "soldPolicyNumberUmbrella",
      String(Number(bru.getVar("soldPolicyNumber")) + 2),
    );
  }
}

tests {
  test("returns 201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("adds exactly one policy", function () {
    const body = res.getBody();
    expect(body.replayed).to.equal(false);
    expect(body.addedPolicyIds).to.have.length(1);
    expect(body.deal.policyCount).to.equal(3);
    expect(body.deal.policies).to.have.length(3);
  });

  test("recomputes the totals from the stored policies", function () {
    // 2175.45 after `Update Policy`, plus the 150.00 Umbrella. The Umbrella's
    // `itemCount` is its implied 1 — only a vehicle policy is counted.
    const deal = res.getBody().deal;
    expect(deal.premium).to.equal(2325.45);
    expect(deal.itemCount).to.equal(5);
    expect(deal.isBundle).to.equal(true);
  });

  test("does not re-date the sale", function () {
    // Still the date `Update Sold Deal (Sold Date)` set.
    expect(res.getBody().deal.soldDate).to.equal("2026-02-14");
  });

  test("reports the audit checklist after generation", function () {
    expect(res.getBody().auditItemCount).to.be.a("number");
  });
}

docs {
  # POST /sold-deals/:id/policies — add policies to a booked sale (PAC-104)

  The Sold form's own policy rows — same fields, same rules, same uploads —
  added to a deal that is already booked. Backs **Add policy** on the Edit sale
  page, which runs the same policy steps as Mark as sold.

  - **Module:** `deal_audits` (must be enabled for the agency)
  - **Permission:** `deal_audits:write` — the same as booking the sale
  - **Data scope:** clamped on the deal; outside it is a **404**

  There is deliberately **no way to remove a policy** from a booked sale.

  ## Body
  | field           | type     | rules |
  |-----------------|----------|-------|
  | policies        | array    | 1–10 rows, each exactly as on `POST /sold-deals` |
  | submissionToken | string   | **required**, 8–200 chars — see Idempotency |

  Uploads are presigned exactly as for the Sold form
  (`POST /sold-deals/documents/presign` with the deal's `leadId`), and verified
  against that lead's key prefix.

  ## What it writes
  - The policies, their `priorPolicies` rows and any escrow interested party —
    in one transaction, through the Sold pipeline's own steps.
  - The deal's `priorInsurance` summary is **merged**, never duplicated: the
    addition only fills what the deal left blank.
  - The deal's totals, **recomputed from its stored policies** (the same
    derivation `PATCH /policies/:id` uses), its audit triggers OR-ed in, and
    `premiumSource: snapshot`.
  - Post-commit, best-effort: the edit log row, the household's active-policy
    count, and audit generation — additive, so every existing item is left
    exactly as it was.

  Not run: the lead status advance, the `sold` timeline entry, CRM assignment.

  ⚠ **This moves reported numbers.** The added premium lands in the deal's
  original sold-date period on the Sold scorecard and the leaderboard.

  ⚠ **Migrated deals are allowed**, and their totals are recomputed from the
  policies linked to them — which may be fewer than the SmartSuite rollup they
  were imported with (product owner's call; the page warns first).

  ## Idempotency
  The token is stored on the deal as `SOLDADD|<token>`. The same token again
  returns `201` with `replayed: true` and writes nothing — including under a
  concurrent double-click, where the second transaction write-conflicts, retries
  and finds the token.

  ## Response `201`
  ```json
  {
    "deal": { "...": "the edit view — see Get Sold Deal For Edit" },
    "addedPolicyIds": ["665f...ac1"],
    "auditItemCount": 9,
    "replayed": false
  }
  ```

  ## Errors
  - `400 Bad Request` — invalid rows (as on create), a policy number already on
    **this** sale, or an upload key from another lead.
  - `401 Unauthorized` — missing/expired access token.
  - `403 Forbidden` — `deal_audits` disabled, or no `deal_audits:write`.
  - `404 Not Found` — unknown/malformed id, out of scope, or a company transfer.
  - `409 Conflict` — the deal's **audit has been submitted** (`Pending` / `Pass`
    / `Fail`); the deal has no lead or no household; or an `existingPolicyId`
    that belongs to **another** sale, which re-pointing would silently remove
    from it.
}
