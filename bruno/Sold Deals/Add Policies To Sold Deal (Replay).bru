meta {
  name: Add Policies To Sold Deal (Replay)
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/sold-deals/{{createdSoldDealId}}/policies
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  ~X-Branch-Id: {{branchId}}
}

body:json {
  {
    "submissionToken": "{{soldAdditionToken}}",
    "policies": [
      {
        "policyType": "Umbrella",
        "effectiveDate": "2026-02-01",
        "carrier": "Allstate",
        "policyNumber": "{{soldPolicyNumberUmbrella}}",
        "premium": 150.00,
        "itemCount": 1,
        "newBusinessApplication": {
          "key": "{{nbaDocumentKey}}",
          "filename": "new-business-application.pdf",
          "contentType": "application/pdf",
          "size": 2048
        },
        "priorInsurance": { "none": true },
        "cancellation": { "cancelled": false }
      }
    ]
  }
}

tests {
  test("returns 201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("is recognised as a replay", function () {
    const body = res.getBody();
    expect(body.replayed).to.equal(true);
    expect(body.addedPolicyIds).to.have.length(0);
  });

  test("adds nothing a second time", function () {
    const deal = res.getBody().deal;
    expect(deal.policyCount).to.equal(3);
    expect(deal.premium).to.equal(2325.45);
  });
}

docs {
  # POST /sold-deals/:id/policies — replay (PAC-104)

  The exact request `Add Policies To Sold Deal` (seq 16) sent, with the same
  `submissionToken`. What a double-click or a retry after a dropped response
  looks like.

  - **Module:** `deal_audits` · **Permission:** `deal_audits:write`

  ## Expected
  `201` with `replayed: true`, no `addedPolicyIds`, and the deal exactly as the
  first request left it. The token is recorded on the deal inside the same
  transaction that adds the policies, so a replay can never add them twice.

  Checked **before** the "audit submitted" block, so a retry still succeeds
  after the audit has since moved on.
}
