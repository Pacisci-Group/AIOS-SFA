meta {
  name: Archive Time Off Policy (Unlimited)
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/hr/policies/{{hrUnlimitedPolicyId}}/archive
  auth: bearer
}

auth:bearer {
  token: {{hrAdminAccessToken}}
}

tests {
  test("returns 204 No Content", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  # POST /hr/policies/:policyId/archive — tidy up the run's Unlimited policy (PAC-174)

  Soft archive: the row, its ledger and history stay. A time off policy with
  a request still `Submitted` against it is a `409` — decide it first.
}
