meta {
  name: Update Time Off Policy (Change compensation, 400)
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/hr/policies/{{hrTimeOffPolicyId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{hrAdminAccessToken}}
}

body:json {
  {
    "timeOff": { "compensation": "unpaid" }
  }
}

tests {
  test("returns 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("says what is locked", function () {
    expect(res.getBody().message).to.match(/locked/);
  });
}

docs {
  # PATCH /hr/policies/:policyId — paid/unpaid and Unlimited are locked (PAC-174)

  Once a policy is active its compensation and its Unlimited-ness cannot
  change: delete it and create a new one. `400` with the reason.
}
