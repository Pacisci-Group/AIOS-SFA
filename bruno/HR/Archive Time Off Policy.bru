meta {
  name: Archive Time Off Policy
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/hr/policies/{{hrTimeOffPolicyId}}/archive
  auth: bearer
}

auth:bearer {
  token: {{hrAdminAccessToken}}
}

tests {
  test("returns 204 No Content", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  # POST /hr/policies/:policyId/archive — tidy up the run's PTO policy (PAC-174)

  Soft archive: the row, its ledger and history stay. A time off policy with
  a request still waiting on a person — **Submitted or Changes Requested**
  (PAC-165) — against it is a `409`: decide it first. Approved leave stays as
  it is; a discarded draft and an imported row never count.
}
