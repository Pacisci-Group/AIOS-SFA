meta {
  name: Get Time Off Policy (After the move)
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/hr/policies/{{hrTimeOffPolicyId}}
  auth: bearer
}

auth:bearer {
  token: {{hrAdminAccessToken}}
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("the person has moved out", function () {
    const body = res.getBody();
    expect(body.memberCount).to.equal(0);
    expect(body.members).to.eql([]);
  });
}

docs {
  # GET /hr/policies/:policyId — a Time off policy with balances (PAC-174)

  Same endpoint as `Get HR Policy`; a `time_off` view carries `timeOff`
  (the rules) and `members[].balanceHours` — each person's **current
  balance**: their `leaveLedger` rows in this policy as of today, so
  approved leave that has not happened yet is not taken off it (PAC-165).
  `null` on Unlimited.
}
