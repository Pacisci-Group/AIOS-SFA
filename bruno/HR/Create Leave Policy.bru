meta {
  name: Create Leave Policy
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/hr/leave-policies
  body: json
  auth: bearer
}

auth:bearer {
  token: {{hrAdminAccessToken}}
}

body:json {
  {
    "name": "Bruno policy {{$timestamp}}",
    "rules": {
      "pto": { "annualAllocationHours": 120 },
      "attendance": { "tardyGraceMinutes": 10 }
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("hrLeavePolicyId", res.getBody().id);
  }
}

tests {
  test("returns 201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("fills the rest from the defaults", function () {
    const body = res.getBody();
    expect(body.version).to.equal(1);
    expect(body.status).to.equal("active");
    expect(body.rules.pto.annualAllocationHours).to.equal(120);
    expect(body.rules.requests.partialDayIncrementMinutes).to.equal(15);
    expect(body.rules.points.ladders.tardy).to.eql([1, 2, 3, 4]);
    expect(body.rules.routing["timeoff.submitted"]).to.eql(["branch_reviewers"]);
  });
}

docs {
  # POST /hr/leave-policies — a named bundle of rules (PAC-161)

  - **Module:** `hr` · **Permission:** `agency:hr:admin`

  ## Body
  `{ "name": "…", "rules": { …partial } }`. Every section of `rules` is
  optional and every field inside it too; **arrays are replaced whole**.
  Whatever is left out is filled from `DEFAULT_LEAVE_POLICY_RULES` — SFA's
  spec values (`@sfa/shared`, `hr-leave-policy.ts`): the epic's §2 table.

  Sections: `leaveTypes`, `reasons`, `requests`, `pto`, `reminders`,
  `attendance`, `points`, `routing`.

  ## Validation
  Shapes and ranges on the body (`400` with the field path); then the rules
  that only hold on the merged whole (`400` listing every problem): at least
  one active leave type, increment ∈ {5, 10, 15, 30, 60}, a fiscal-year
  start when the reset is fiscal, a cap when carryover is capped, a floor
  when a negative balance is floored, ascending unique point thresholds,
  non-empty ladders while points are on.

  ## Response `201` — `LeavePolicyView` (summary + `rules`).

  ## Errors
  - `409` — an active policy with that name exists (case-insensitive).
}
