meta {
  name: Get HR Policy
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/hr/policies/{{hrPolicyId}}
  auth: bearer
}

auth:bearer {
  token: {{hrAdminAccessToken}}
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("is the policy just created", function () {
    expect(res.getBody().id).to.equal(bru.getVar("hrPolicyId"));
  });
}

docs {
  # GET /hr/policies/:policyId — one policy with its members (PAC-161 v3)

  Module `hr`, permission `agency:hr:admin`. `404` for an unknown or archived
  policy, `400` for a malformed id. `members[]` lists only people who have not
  been removed from the agency.
}
