meta {
  name: List Notifications (Bad Cursor, 400)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/notifications?cursor=not-a-cursor
  body: none
  auth: bearer
}

params:query {
  cursor: not-a-cursor
}

auth:bearer {
  token: {{notifAdminAccessToken}}
}

tests {
  test("returns 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  # GET /notifications?cursor=… — a cursor the API did not mint

  `cursor` is opaque to clients and validated by the service: anything that is
  not exactly `base64url("<createdAt ISO>|<_id hex>")` is a **400**, never an
  empty page — a client that corrupted its cursor should find out.
}
