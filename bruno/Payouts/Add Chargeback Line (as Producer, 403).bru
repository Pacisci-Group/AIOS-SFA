meta {
  name: Add Chargeback Line (as Producer, 403)
  type: http
  seq: 57
}

post {
  url: {{baseUrl}}/payouts/statements/{{payoutsStatementId}}/adjustments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{payoutsProducerToken}}
}

body:json {
  {
    "kind": "exclude_chargeback",
    "chargebackId": "000000000000000000000000",
    "note": "Not mine to decide"
  }
}

script:pre-request {
  if (!bru.getVar("payoutsStatementId")) bru.runner.skipRequest();
}

tests {
  test("returns 403: chargeback lines are the reviewer's", function () {
    expect(res.getStatus()).to.equal(403);
  });
}

docs {
  # POST /payouts/statements/:id/adjustments — not the employee's

  The employee holds `payouts:read`; correcting a statement needs
  `payouts:write`. See **Add Chargeback Line**.
}
