meta {
  name: Dispute Pay Statement (Again, 409)
  type: http
  seq: 73
}

post {
  url: {{baseUrl}}/payouts/statements/{{payoutsStatementId}}/reject
  body: json
  auth: bearer
}

auth:bearer {
  token: {{payoutsProducerToken}}
}

body:json {
  {
    "notes": "And again"
  }
}

script:pre-request {
  if (!bru.getVar("payoutsStatementId")) bru.runner.skipRequest();
}

tests {
  test("returns 409 PAYOUT_STATEMENT_NOT_SENT", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().code).to.equal("PAYOUT_STATEMENT_NOT_SENT");
  });
}

docs {
  # POST /payouts/statements/:id/reject — already disputed

  A version is answered once. See **Dispute Pay Statement**.
}
