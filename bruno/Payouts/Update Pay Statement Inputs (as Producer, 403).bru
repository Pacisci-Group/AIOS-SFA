meta {
  name: Update Pay Statement Inputs (as Producer, 403)
  type: http
  seq: 50
}

patch {
  url: {{baseUrl}}/payouts/statements/{{payoutsStatementId}}/inputs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{payoutsProducerToken}}
}

body:json {
  {
    "compliancePercent": 100,
    "retentionPercent": null,
    "lifeReferrals": null,
    "meetingAttendance": null
  }
}

script:pre-request {
  if (!bru.getVar("payoutsStatementId")) bru.runner.skipRequest();
}

tests {
  test("returns 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}

docs {
  # PATCH /payouts/statements/:id/inputs — a producer cannot enter figures

  `payouts:read` holders (everyone) see their own sent statements; entering
  the figures needs `payouts:write`. See **Update Pay Statement Inputs**.
}
