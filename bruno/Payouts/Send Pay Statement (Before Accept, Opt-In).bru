meta {
  name: Send Pay Statement (Before Accept, Opt-In)
  type: http
  seq: 83
}

post {
  url: {{baseUrl}}/payouts/statements/{{payoutsStatementId}}/send
  auth: bearer
}

auth:bearer {
  token: {{payoutsOwnerToken}}
}

script:pre-request {
  // Opt-in only: accepting is final, so a run that accepts the month's
  // statement makes every later run fail until the month changes. Run with
  // `--env-var payoutsAcceptStatement=true` on a database you can spare.
  if (
    !bru.getVar("payoutsStatementId") ||
    String(bru.getEnvVar("payoutsAcceptStatement")) !== "true"
  ) {
    bru.runner.skipRequest();
  }
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("sent");
  });
}

docs {
  # POST /payouts/statements/:id/send — before the opt-in accept

  Sends the demo statement for **Accept Pay Statement**. Opt-in: see that
  request.
}
