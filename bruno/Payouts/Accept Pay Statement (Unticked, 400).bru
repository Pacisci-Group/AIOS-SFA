meta {
  name: Accept Pay Statement (Unticked, 400)
  type: http
  seq: 70
}

post {
  url: {{baseUrl}}/payouts/statements/{{payoutsStatementId}}/accept
  body: json
  auth: bearer
}

auth:bearer {
  token: {{payoutsProducerToken}}
}

body:json {
  {
    "typedName": "Pat Producer",
    "acknowledged": false
  }
}

script:pre-request {
  if (!bru.getVar("payoutsStatementId")) bru.runner.skipRequest();
}

tests {
  test("returns 400: the box must be ticked", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  # POST /payouts/statements/:id/accept — the acknowledgment unticked

  `acknowledged` must be `true`. See **Accept Pay Statement**.
}
