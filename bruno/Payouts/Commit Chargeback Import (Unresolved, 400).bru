meta {
  name: Commit Chargeback Import (Unresolved, 400)
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/payouts/imports/{{payoutsImportId}}/commit
  auth: bearer
}

auth:bearer {
  token: {{payoutsOwnerToken}}
}

tests {
  test("refused while a line needs a person (409 once committed)", function () {
    expect([400, 409]).to.include(res.getStatus());
  });

  test("says how many lines need a person", function () {
    if (res.getStatus() !== 400) return;
    expect(res.getBody().code).to.equal("PAYOUT_IMPORT_UNRESOLVED_ROWS");
    expect(res.getBody().unresolved).to.equal(1);
  });
}

docs {
  # POST /payouts/imports/:id/commit — refused: a line needs a person

  400 `PAYOUT_IMPORT_UNRESOLVED_ROWS` + `unresolved` while any line is
  `unmatched`. On a rerun against the same database the import is already
  committed: 409 `PAYOUT_IMPORT_NOT_EDITABLE`.
}
