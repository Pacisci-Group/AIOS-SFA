meta {
  name: Reopen Pay Statement (Cleanup)
  type: http
  seq: 82
}

post {
  url: {{baseUrl}}/payouts/statements/{{payoutsStatementId}}/reopen
  auth: bearer
}

auth:bearer {
  token: {{payoutsOwnerToken}}
}

script:pre-request {
  // Only Send All Drafts left it sent; when that was skipped, it is a draft.
  if (
    !bru.getVar("payoutsStatementId") ||
    !bru.getVar("payoutsRunId") ||
    Number(bru.getVar("payoutsRunStatements")) !== 1
  ) {
    bru.runner.skipRequest();
  }
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("draft");
  });
}

docs {
  # POST /payouts/statements/:id/reopen — folder cleanup

  Leaves the demo producer's statement a draft, as the folder found it, so a
  rerun passes **Get Pay Statement (as Producer, Draft, 404)** and **Update
  Pay Statement Inputs**. Each run adds two versions to its `history`.
  Skipped with **Send All Drafts**, which is what left it sent.
}
