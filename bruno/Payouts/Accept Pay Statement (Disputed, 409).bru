meta {
  name: Accept Pay Statement (Disputed, 409)
  type: http
  seq: 74
}

post {
  url: {{baseUrl}}/payouts/statements/{{payoutsStatementId}}/accept
  body: json
  auth: bearer
}

auth:bearer {
  token: {{payoutsProducerToken}}
}

body:json {
  {
    "typedName": "Pat Producer",
    "acknowledged": true
  }
}

script:pre-request {
  if (!bru.getVar("payoutsStatementId")) bru.runner.skipRequest();
}

tests {
  test("returns 409 PAYOUT_STATEMENT_NOT_SENT", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().code).to.equal("PAYOUT_STATEMENT_NOT_SENT");
  });
}

docs {
  # POST /payouts/statements/:id/accept — a disputed statement

  It waits to be corrected and sent again. See **Accept Pay Statement**.
}
