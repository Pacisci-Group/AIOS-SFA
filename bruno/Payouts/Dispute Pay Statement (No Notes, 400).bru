meta {
  name: Dispute Pay Statement (No Notes, 400)
  type: http
  seq: 71
}

post {
  url: {{baseUrl}}/payouts/statements/{{payoutsStatementId}}/reject
  body: json
  auth: bearer
}

auth:bearer {
  token: {{payoutsProducerToken}}
}

body:json {
  {
    "notes": "   "
  }
}

script:pre-request {
  if (!bru.getVar("payoutsStatementId")) bru.runner.skipRequest();
}

tests {
  test("returns 400: say what is wrong", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  # POST /payouts/statements/:id/reject — blank notes

  Notes are required (after trimming). See **Dispute Pay Statement**.
}
