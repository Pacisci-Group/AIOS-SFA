meta {
  name: Get Pay Statement PDF Link (Signed, Not Accepted, 404)
  type: http
  seq: 75
}

get {
  url: {{baseUrl}}/payouts/statements/{{payoutsStatementId}}/pdf?variant=signed
  auth: bearer
}

auth:bearer {
  token: {{payoutsProducerToken}}
}

script:pre-request {
  if (!bru.getVar("payoutsStatementId")) bru.runner.skipRequest();
}

params:query {
  variant: signed
}

tests {
  test("returns 404: only an accepted statement has a signed copy", function () {
    expect(res.getStatus()).to.equal(404);
  });
}

docs {
  # GET /payouts/statements/:id/pdf?variant=signed — before it is accepted

  See **Get Pay Statement PDF Link**.
}
