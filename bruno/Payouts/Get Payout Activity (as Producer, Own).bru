meta {
  name: Get Payout Activity (as Producer, Own)
  type: http
  seq: 28
}

get {
  url: {{baseUrl}}/payouts/activity?month={{payoutsMonth}}
  auth: bearer
}

params:query {
  month: {{payoutsMonth}}
}

auth:bearer {
  token: {{payoutsProducerToken}}
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("is their own", function () {
    expect(res.getBody().userId).to.equal(bru.getVar("payoutsProducerUserId"));
    // Their statement is still a draft, so it is not theirs to open yet.
    expect(res.getBody().statementId).to.equal(null);
  });
}

docs {
  # GET /payouts/activity — a producer's own month (PAC-179)

  No `userId`: the caller. Every employee sees what they sold and had
  charged back, any month, before their statement is sent.
}
