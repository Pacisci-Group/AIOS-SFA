meta {
  name: Reopen Pay Statement
  type: http
  seq: 78
}

post {
  url: {{baseUrl}}/payouts/statements/{{payoutsStatementId}}/reopen
  auth: bearer
}

auth:bearer {
  token: {{payoutsOwnerToken}}
}

script:pre-request {
  if (!bru.getVar("payoutsStatementId")) bru.runner.skipRequest();
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("is a draft again, with the issued version kept", function () {
    const s = res.getBody();
    expect(s.status).to.equal("draft");
    expect(s.pdf).to.equal(null);
    expect(s.sentAt).to.equal(null);
    expect(s.version).to.equal(s.history.length + 1);
    const last = s.history[s.history.length - 1];
    expect(last.outcome).to.equal("reopened");
    expect(last.version).to.equal(s.version - 1);
    expect(last.pdf.sha256).to.match(/^[a-f0-9]{64}$/);
  });
}

docs {
  # POST /payouts/statements/:id/reopen — back to draft (PAC-181)

  **Module** — `payouts`. **Permission** — `payouts:write`, within your data
  scope. Not your **own** statement without `agency:payouts:admin`.

  A **sent** statement goes back to draft before the employee answers (an
  accepted one is final). The issued version moves into `history` as
  `{ version, outcome: "reopened", pdf, sentAt, sentBy, at }` — its file is
  kept and still opens with `GET …/pdf?version=<n>` for a reviewer — and the
  draft becomes the next version. The employee is not notified; to them the
  statement is a `404` again until it is sent.

  A month's recalculation never deletes a reopened draft, even for someone
  who has left the structure: it recalculates it by the rules it was
  drafted with, and its warnings say they are no longer on a structure.

  **Errors** — `403` without `payouts:write`, or
  `PAYOUT_STATEMENT_OWN_STATEMENT` on your own statement without
  `agency:payouts:admin`; `404` outside your scope; `409`
  `PAYOUT_STATEMENT_NOT_SENT` for anything but a sent statement, `409`
  `PAYOUT_STATEMENT_CHANGED` when it changed meanwhile and is still sent.
}
