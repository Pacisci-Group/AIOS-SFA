meta {
  name: Accept Pay Statement (as Owner, 403)
  type: http
  seq: 69
}

post {
  url: {{baseUrl}}/payouts/statements/{{payoutsStatementId}}/accept
  body: json
  auth: bearer
}

auth:bearer {
  token: {{payoutsOwnerToken}}
}

body:json {
  {
    "typedName": "Olive Owner",
    "acknowledged": true
  }
}

script:pre-request {
  if (!bru.getVar("payoutsStatementId")) bru.runner.skipRequest();
}

tests {
  test("returns 403 PAYOUT_STATEMENT_NOT_YOURS", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().code).to.equal("PAYOUT_STATEMENT_NOT_YOURS");
  });
}

docs {
  # POST /payouts/statements/:id/accept — not the reviewer's

  Only the person a statement is for answers it — not a reviewer, not even
  the owner with `agency:payouts:admin`. See **Accept Pay Statement**.
}
