meta {
  name: Send Pay Statement (Already Sent, 409)
  type: http
  seq: 58
}

post {
  url: {{baseUrl}}/payouts/statements/{{payoutsStatementId}}/send
  auth: bearer
}

auth:bearer {
  token: {{payoutsOwnerToken}}
}

script:pre-request {
  if (!bru.getVar("payoutsStatementId")) bru.runner.skipRequest();
}

tests {
  test("returns 409 PAYOUT_STATEMENT_NOT_EDITABLE", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().code).to.equal("PAYOUT_STATEMENT_NOT_EDITABLE");
  });
}

docs {
  # POST /payouts/statements/:id/send — again

  A sent statement is not sent twice: no second file, no second
  notification. Reopen it first. See **Send Pay Statement**.
}
