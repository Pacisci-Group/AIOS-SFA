meta {
  name: Get HR Calendar (Range too long, 400)
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/hr/calendar?from={{calMon}}&to={{calTooFar}}
  auth: bearer
}

auth:bearer {
  token: {{calProducerToken}}
}

tests {
  test("returns 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  # GET /hr/calendar — at most 92 days

  Every layer but the events is computed per day or per person, so the range
  is bounded: 92 days inclusive is accepted, 93 is a `400`.
}
