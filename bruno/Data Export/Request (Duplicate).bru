meta {
  name: Request (Duplicate)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/data-export/sold_deals/exports
  body: json
  auth: bearer
}

auth:bearer {
  token: {{dataExportToken}}
}

body:json {
  {
    "format": "csv",
    "from": "2026-01-01"
  }
}

tests {
  test("the same request again is a 409", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().code).to.equal("EXPORT_DUPLICATE");
  });

  test("hands back the export the caller already has", function () {
    const existing = res.getBody().existing;
    expect(existing.id).to.equal(bru.getVar("dataExportId"));
    expect(["queued", "processing", "ready"]).to.include(existing.status);
  });

  test("says when the same request will be accepted again", function () {
    const retryAt = Date.parse(res.getBody().retryAt);
    expect(Number.isNaN(retryAt)).to.equal(false);
    expect(retryAt).to.be.above(Date.now());
  });
}

docs {
  # POST /data-export/sold_deals/exports — the same request twice

  **Request Sold Deals Export (CSV)** again. That request was made less than
  an hour ago, so this is a `409` with `code: "EXPORT_DUPLICATE"`, the export
  in `existing` and `retryAt`, the ISO instant from which the same request is
  accepted again. Nothing is queued or logged.

  The request's identity is the caller, their data scope, the dataset, the
  `format` and every filter, the multi-selects in any order. The window is
  `DATA_EXPORT_DUPLICATE_WINDOW_MINUTES` (default 60), counted from when the
  earlier request was made. A `failed` export does not count. After the
  window a new export is queued, and the earlier one stays downloadable until
  it expires. See **Request Sold Deals Export (CSV)**.
}
