meta {
  name: Update Lead (Future Date)
  type: http
  seq: 23
}

patch {
  url: {{baseUrl}}/leads/{{createdLeadId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  ~X-Branch-Id: {{branchId}}
}

body:json {
  {
    "createdDate": "2999-01-01"
  }
}

tests {
  test("rejects a lead date after today on the agency's calendar", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().message).to.contain("Lead date cannot be in the future");
  });
}

docs {
  # PATCH /leads/:id — a lead date in the future is refused (PAC-159)

  "Today" is today in `Agency.timezone`, never the server clock's UTC day or
  the browser's. The same rule guards `POST /leads`, `POST /sold-deals`,
  `PATCH /sold-deals/:id`, `POST /quote-recaps` and `PATCH /quote-recaps/:id`;
  the forms set `max` on their date inputs so the common case never reaches
  the API.
}
