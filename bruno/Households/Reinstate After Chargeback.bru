meta {
  name: Reinstate After Chargeback
  type: http
  seq: 19
}

patch {
  url: {{baseUrl}}/households/{{policyCancelHouseholdId}}/policies/{{policyCancelPolicyId}}
  body: json
  auth: inherit
}

headers {
  ~X-Branch-Id: {{branchId}}
}

body:json {
  {
    "status": "Active"
  }
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("the policy is back on the books, its cancellation cleared", function () {
    const body = res.getBody();
    expect(body.policyStatus).to.equal("Active");
    expect(body.active).to.equal(true);
    expect(body.cancellation).to.equal(null);
  });
}

docs {
  # PATCH /households/:id/policies/:policyId — put the policy back

  Leaves the household as the folder found it, as `Reinstate Cancelled
  Policy` does. The chargeback stays in the ledger: reversing one is a
  reversal row, which nothing writes yet (PAC-123). See `Update Household
  Policy` for the endpoint.
}
