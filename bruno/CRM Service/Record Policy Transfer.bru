meta {
  name: Record Policy Transfer
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/crm/service-tickets/{{crmTicketId}}/policy-transfer
  body: json
  auth: bearer
}

auth:bearer {
  token: {{crmAccessToken}}
}

headers {
  Content-Type: application/json
}

script:pre-request {
  // Allstate policy numbers are digits only, and a policy number is unique per
  // agency — so a fixed literal here books once and then collides forever.
  bru.setVar("transferPolicyNumber", String(Date.now()).slice(-9));
}

body:json {
  {
    "transferDate": "2026-03-10",
    "policies": [
      {
        "fromPolicyId": "{{crmFromPolicyId}}",
        "policyType": "Auto",
        "effectiveDate": "2026-03-15",
        "carrier": "Allstate",
        "policyNumber": "{{transferPolicyNumber}}",
        "premium": 900,
        "itemCount": 1,
        "newBusinessApplication": {
          "key": "{{transferDocumentKey}}",
          "filename": "application.pdf",
          "contentType": "application/pdf",
          "size": 2048
        }
      }
    ],
    "submissionToken": "{{$guid}}"
  }
}

tests {
  test("returns 201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the refreshed ticket carrying the transfer", function () {
    const body = res.getBody();
    expect(body.allowsPolicyTransfer).to.equal(true);
    expect(body.policyTransfer).to.not.equal(null);
    expect(body.policyTransfer.pairs).to.have.lengthOf(1);
  });

  test("links the retired policy to its replacement", function () {
    const pair = res.getBody().policyTransfer.pairs[0];
    expect(pair.fromPolicyId).to.equal(bru.getVar("crmFromPolicyId"));
    expect(pair.toPolicyId).to.be.a("string");
    expect(pair.toPolicyNumber).to.equal(bru.getVar("transferPolicyNumber"));
    // The two sides are a *pair*, not a rename: the replacement is a new policy
    // with its own type and premium, and the delta is what the client is being
    // asked to accept.
    expect(pair.toPremium).to.equal(900);
    expect(pair.fromPremium).to.be.a("number");
  });

  test("summarizes the transfer for the ticket header", function () {
    const transfer = res.getBody().policyTransfer;
    expect(transfer.policyCount).to.equal(1);
    expect(transfer.premiumDelta).to.equal(900 - transfer.pairs[0].fromPremium);
    expect(transfer.recordedByName).to.be.a("string");
    expect(transfer.dealId).to.be.a("string");
    // Booked through the sold pipeline, so it generates an audit like any deal.
    expect(transfer.dealAuditId).to.be.a("string");
  });

  test("logs a system entry on the ticket", function () {
    const timeline = res.getBody().timeline;
    expect(timeline.some((e) => e.type === "system")).to.equal(true);
  });
}

docs {
  # POST /crm/service-tickets/:id/policy-transfer — book a company transfer

  Moves a client's policy from one carrier to another: retires the policy named
  in `fromPolicyId` and writes its replacement, as one deal.

  - **Module:** `crm_service`
  - **Permission:** `crm_service:write`

  ## It runs the sold-deal pipeline, not a bespoke writer

  `PolicyTransfersService.record` builds a `SoldIntakeDto` and hands it to the
  same intake that `POST /sold-deals` uses, with `businessType:
  'company_transfer'`. That is why the response carries a `dealId` and a
  `dealAuditId`, why the policy-number format rules apply, and why prior
  insurance and cancellation are *injected* as `{none: true}` /
  `{cancelled: false}` rather than asked for — a transfer is not new business
  arriving from somewhere else.

  The producer leaderboard excludes transfers outright, so booking one cannot
  rank a CSR against producers.

  ## Three things this body gets wrong if you copy it carelessly

  1. **`policyNumber` must be digits only** for Allstate
     (`assertPolicyNumberFormats`), and is unique per agency — hence the
     timestamp in the pre-request script rather than a literal.
  2. **`newBusinessApplication.key` must be a key this ticket's household
     presigned** *and* must exist in storage. See `Upload Transfer Document`.
  3. **`fromPolicyId` must belong to the ticket's household.** The scope clamp
     on this endpoint is the *ticket*; without that check a CSR could retire any
     policy in the agency by naming its id.

  ## One transfer per ticket

  A second call is a `409`, guarded by a unique index on
  `{agencyId, ticketId}` over `deals` rather than by the read alone. That is why
  this folder opens its own ticket every run — see `Open Transfer Ticket`.

  ## Errors
  - `400` — the ticket's category does not allow a transfer, a malformed policy
    number, or a `fromPolicyId` from another household.
  - `404` — no such ticket, or the declared document is not in storage.
  - `409` — this ticket already carries a transfer.
}
