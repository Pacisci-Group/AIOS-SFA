meta {
  name: Send Time Off Request (Past date, 400)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/time-off/requests
  body: json
  auth: bearer
}

auth:bearer {
  token: {{timeOffProducerToken}}
}

body:json {
  {
    "policyId": "{{timeOffPolicyId}}",
    "firstDay": "{{torPast}}",
    "lastDay": "{{torPast}}",
    "dayMode": "full",
    "send": true
  }
}

tests {
  test("returns 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("an employee's own request starts today or later", function () {
    expect(res.getBody().code).to.equal("past_date");
  });
}

docs {
  # POST /time-off/requests — past dates only when recorded

  An employee's own request must start **today or later** on the agency's
  calendar: `400 { code: "past_date" }`. A day already gone is **recorded** by
  someone holding `hr:write` and `agency:users:read` — see
  `Record Time Off (Past date)`.
}
