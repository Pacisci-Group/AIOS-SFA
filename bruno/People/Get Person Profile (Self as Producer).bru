meta {
  name: Get Person Profile (Self as Producer)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/users/{{peopleProducerId}}/profile
  auth: bearer
}

auth:bearer {
  token: {{peopleProducerToken}}
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("own profile, with balances and the week (hr:read)", function () {
    const body = res.getBody();
    expect(body.user.id).to.equal(bru.getVar("peopleProducerId"));
    expect(body).to.have.property("timeOff");
    expect(body).to.have.property("schedule");
    expect(body.employment).to.have.property("dateOfBirth");
  });
}

docs {
  # GET /users/:userId/profile — your own (PAC-162)

  Anyone may read their own profile without `agency:users:read`; the time
  off and schedule sections come with `hr:read`, which every employee
  template holds. The demo producer is seeded `active` with a hire date, a
  date of birth and a phone, and is in the seeded PTO and Sick policies.
}
