meta {
  name: Get New Rows File URL
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/platform/mailer-campaigns/{{campaignId}}/files/new-rows/url
  body: none
  auth: bearer
}

auth:bearer {
  token: {{platformAccessToken}}
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("names the new-rows file", function () {
    expect(res.getBody().filename).to.equal("SFA-QBP-new-rows.csv");
  });
}

docs {
  # GET /platform/mailer-campaigns/:campaignId/files/new-rows/url

  The same endpoint as `Get Output File URL` with `kind = new-rows`: a
  short-lived download of the rows the **last** commit created, which is the
  file the completion email links after Add records. `404` on a campaign that
  has only committed once — its full output is the new rows then.
}
