script:pre-request {
  // Same byte count as `Upload Campaign File`, for the same reason: `Add
  // Campaign Files` re-checks the declared size against `HeadObject`.
  const body = req.getBody();
  let bytes = 0;
  for (let i = 0; i < body.length; i++) {
    const code = body.charCodeAt(i);
    if (code < 0x80) bytes += 1;
    else if (code < 0x800) bytes += 2;
    else if (code >= 0xd800 && code <= 0xdbff) { bytes += 4; i += 1; }
    else bytes += 3;
  }
  bru.setVar("campaignSecondFileSize", bytes);
}

tests {
  test("storage accepts the upload", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  # PUT <uploadUrl> — the "missed records" file for Add records (PAC-142)

  Not an API endpoint; goes straight to object storage, as `Upload Campaign
  File` does. Same header rule: `Content-Type` must match the signed value.

  ## The body

  Two rows with the **same columns** as the first file — a file whose columns
  differ is refused by the preview, naming it. One row (`…ee01`, Dana Okafor)
  is already in the campaign from the first commit and will be **updated, not
  printed**; the other (`…ee03`) is new and is the only row the re-commit's
  `newRowsFile` will carry. That is the whole point of Add records: the mail
  house receives what it has not printed yet, and nothing else.
}
