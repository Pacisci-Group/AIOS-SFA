  #7c1e4a90-3333-4b8a-9f10-9c41b2d7ee03,9c41b2d7ee03,Imani,Castillo,88 E Frank Phillips Blvd,Bartlesville,OK,74003-3300,147,1650,2005,"$250,000.00","$25,000.00","$25,000.00","$1,000.00/person","$100,000.00/occurrence","$1,200.00","$1,200.00",100.00,4,Week_Number-98,SFA-QBP,Home,FQ,46216,A0B9049,SMITH FAMILY AGENCY,No,No
