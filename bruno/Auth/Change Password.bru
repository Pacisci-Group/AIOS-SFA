meta {
  name: Change Password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "{{password}}"
  }
}

script:post-response {
  // The change bumped tokenVersion, so the pair that authenticated THIS
  // request is now dead. Re-capture the fresh one or every later request in
  // the run 401s. (New password == old password on purpose — it exercises the
  // endpoint while leaving the demo credentials usable for the next run.)
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setVar("accessToken", body.accessToken);
    bru.setVar("refreshToken", body.refreshToken);
  }
}

tests {
  test("returns 201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns a fresh token pair and the auth-user blob", function () {
    const body = res.getBody();
    expect(body).to.have.property("accessToken");
    expect(body).to.have.property("refreshToken");
    expect(body).to.have.property("user");
  });
}

docs {
  # POST /auth/change-password — authenticated self-service (PAC-81)

  **Module:** none (`@SkipTenant`, `@SkipBranch`, `@SkipModule`).
  **Permission:** none beyond a valid access token — everyone may change their
  own password.
  **Throttle:** `CHANGE_PASSWORD_RATE_LIMIT` (default 5/min per IP).

  **Body**
  | field           | type   | rules                   |
  |-----------------|--------|-------------------------|
  | currentPassword | string | non-empty               |
  | newPassword     | string | non-empty, min length 8 |

  Verifies the current password, re-hashes at bcrypt cost 12, clears any
  pending reset/invite token (one live credential per account), and bumps
  `tokenVersion` — which **ends every session for the account, including the
  one making the request**. The response therefore carries a fresh pair the
  client must store, exactly like `POST /auth/reset-password`.

  **Response `201`** — same shape as login: `{ accessToken, refreshToken, user }`.

  Open to **any** authenticated session, impersonated ones included — the
  current-password check is the identity proof, applied to everyone equally.

  **Errors**
  - `400` — wrong current password (`"Current password is incorrect."`).
    Deliberately **not** a 401: the web client treats a 401 as a dead session
    and would sign the user out over a typo.
  - `401` — no/expired token, or the user was deactivated.
  - `429` — rate limit.
}
