meta {
  name: Forgot Password (Unknown Email, Public)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "nobody-with-this-address@demoagency.local"
  }
}

tests {
  test("returns the identical 202 for an unknown address", function () {
    // The enumeration guard, pinned: this response must be byte-for-byte the
    // one a real address gets. If these two requests ever diverge, the login
    // page has become an account oracle.
    expect(res.getStatus()).to.equal(202);
    expect(res.getBody().message).to.equal(
      "If an account exists for that address, a password reset link is on its way."
    );
  });
}

docs {
  # POST /auth/forgot-password — the unknown-address half of the contract

  Same endpoint as `Forgot Password (Public)`; this request exists purely to
  pin the **uniform response**: an address that matches no account gets
  exactly the same `202` and message as one that does. See that request's
  docs for the full endpoint description.
}
