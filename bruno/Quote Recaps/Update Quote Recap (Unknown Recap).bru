meta {
  name: Update Quote Recap (Unknown Recap)
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/quote-recaps/000000000000000000000000
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  ~X-Branch-Id: {{branchId}}
}

body:json {
  {
    "notes": "Should never be written."
  }
}

tests {
  test("returns 404, not 403", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("says nothing about whether the recap exists", function () {
    expect(res.getBody().message).to.equal("Quote recap not found.");
  });
}

docs {
  # PATCH /quote-recaps/:id for a recap that isn't yours — 404

  A well-formed ObjectId that matches no recap in this agency. The same 404 is
  returned for a **malformed** id, an **unknown** recap, **another agency's**
  recap, and one **outside the caller's data scope** — deliberately
  indistinguishable, because a 403 would confirm the record exists.

  Mirrors `Create Quote Recap (Foreign Lead).bru`, and matches
  `LeadAccessService.loadOwnedLead` / `PoliciesService.loadOwnedPolicy`.
}
