meta {
  name: Update Quote Recap (Future Date)
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/quote-recaps/{{createdQuoteRecapId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  ~X-Branch-Id: {{branchId}}
}

body:json {
  {
    "quoteDate": "2999-01-01"
  }
}

tests {
  test("rejects a quote date after today on the agency's calendar", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().message).to.contain("Quote date cannot be in the future");
  });
}

docs {
  # PATCH /quote-recaps/:id — a quote date in the future is refused (PAC-159)

  "Today" is today in `Agency.timezone`. The same rule guards
  `POST /quote-recaps`; the form sets `max` on the date input so the common
  case never reaches the API.
}
