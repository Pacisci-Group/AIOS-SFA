meta {
  name: List Deal Audits
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/deal-audits?page=1&pageSize=8&due=all
  body: none
  auth: inherit
}

params:query {
  page: 1
  pageSize: 8
  due: all
}

headers {
  ~X-Branch-Id: {{branchId}}
}

script:post-response {
  // Capture the first row's ids so the rest of this folder has something to act
  // on. Runtime-only vars (never persisted to disk).
  //
  // `auditDealId` keeps the folder **self-sufficient**: the workflow requests
  // are keyed on the deal, and Bruno runs folders alphabetically — so "Deal
  // Audits" executes long before "Sold Deals" could set `createdSoldDealId`.
  if (res.getStatus() === 200) {
    const items = res.getBody().items || [];

    // The workflow requests submit then review, so they need a deal that is not
    // already awaiting review. Since PAC-106 every row on this board is one —
    // the board lists only `Not Submitted` and `Fail` (a `Pending` audit is
    // with the manager) — so the filter is belt and braces.
    //
    // Prefer a row with something still open: the presign / resolve /
    // download requests need an outstanding item, and since PAC-106 a card
    // stays on the board once all its items are resolved ("Ready to submit").
    const workable = items.filter((row) => row.auditStatus !== "Pending");
    const target =
      workable.find((row) => (row.items || []).some((entry) => entry.open)) ||
      workable[0] ||
      items[0];

    if (target) {
      bru.setVar("auditDealId", target.dealId);
      // A row is a **deal** since PAC-72, so the item id the presign / resolve
      // / download requests need lives on the nested checklist. Take the first
      // still-outstanding one — resolving a settled item is a no-op.
      const open = (target.items || []).filter((entry) => entry.open);
      if (open.length > 0) {
        bru.setVar("dealAuditItemId", open[0].id);
      }
    }
  }
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a paginated envelope", function () {
    const body = res.getBody();
    expect(body).to.have.property("page");
    expect(body).to.have.property("pageSize");
    expect(body).to.have.property("total");
    expect(body).to.have.property("totalPages");
    expect(body).to.have.property("items");
    expect(body.items).to.be.an("array");
  });

  test("rows are masked (no raw ObjectId in ref)", function () {
    const items = res.getBody().items;
    if (items.length > 0) {
      expect(items[0].ref).to.match(/^AUD-\d{4}-\d{4}$/);
    }
  });

  test("a row is one deal, carrying its whole checklist", function () {
    // PAC-72 section A item 1. Before this a row was one requirement, so a
    // bundled sale rendered as six rows with six Resolve buttons.
    const items = res.getBody().items;
    if (items.length > 0) {
      const row = items[0];
      expect(row).to.have.property("dealId");
      expect(row).to.have.property("auditStatus");
      expect(row.items).to.be.an("array");
      expect(row.itemCount).to.be.at.least(row.openCount);
      expect(row.itemCount).to.be.above(0);
    }
  });

  test("only audits waiting on the producer are on the board (PAC-106)", function () {
    // Not Submitted, or sent back (Fail). Pending is with the manager and
    // Pass is finished; neither has anything for the producer to do.
    for (const row of res.getBody().items) {
      expect(["Not Submitted", "Fail"]).to.include(row.auditStatus);
      expect(row.readyToSubmit).to.equal(row.openCount === 0);
    }
  });

  test("a sent-back row carries the manager's marker", function () {
    for (const row of res.getBody().items) {
      if (row.auditStatus === "Fail" && row.sentBack) {
        expect(row.sentBack).to.have.property("note");
        expect(row.sentBack).to.have.property("byName");
        expect(row.sentBack.failedItemCount).to.be.at.least(1);
      }
    }
  });

  test("checklist entries say who must act and what the manager ruled", function () {
    for (const row of res.getBody().items) {
      for (const entry of row.items) {
        expect(entry.requiresUpload).to.be.a("boolean");
        expect(entry.managerOnly).to.be.a("boolean");
        expect(entry).to.have.property("review");
        // A manager-only item is here only because the manager failed it.
        if (entry.managerOnly) {
          expect(entry.review.verdict).to.equal("fail");
        }
      }
    }
  });

  test("completion is a whole percent, bounded by the counters", function () {
    /*
     * The figure that replaced David's rejected checkmarks.
     *
     * ⚠ It is `resolvedCount / itemCount`, NOT `(itemCount - openCount) /
     * itemCount`. `openCount` is `openFailedCount` — items that **failed** and
     * are still open — and an item that is merely `in_progress` is in neither
     * counter. This test used to recompute the percentage the second way and
     * passed only by luck of which row sorted first: on the demo seed, 13 of 18
     * audits have `resolvedCount != itemCount - openFailedCount`.
     *
     * So: assert the contract that actually holds. `resolvedCount` is not on
     * the row (deliberately — the board renders a bar, not two numbers), which
     * bounds what can be checked from here.
     */
    const items = res.getBody().items;
    if (items.length > 0) {
      const row = items[0];
      expect(row.completionPct).to.be.within(0, 100);
      expect(row.completionPct % 1).to.equal(0);
      // Every unresolved-and-failed item is necessarily unresolved, so the
      // percentage can never exceed what the open counter leaves room for.
      const mostItCouldBe = Math.round(
        ((row.itemCount - row.openCount) / row.itemCount) * 100,
      );
      expect(row.completionPct).to.be.at.most(mostItCouldBe);
    }
  });

  test("outstanding requirements sort above settled ones", function () {
    // "Missing requirements colour-coded and sorted to the top" (item 5) — the
    // server owns the order so the drawer renders the list as given.
    const items = res.getBody().items;
    if (items.length > 0) {
      const flags = items[0].items.map((entry) => entry.open);
      expect(flags.indexOf(false) === -1 || flags.lastIndexOf(true) < flags.indexOf(false)).to.equal(true);
    }
  });

  test("checklist entries carry the soft deadline and any evidence on file", function () {
    const items = res.getBody().items;
    if (items.length > 0 && items[0].items.length > 0) {
      expect(items[0].items[0]).to.have.property("dueAt");
      expect(items[0].items[0].attachments).to.be.an("array");
    }
  });

  test("attachments expose an index, never the storage key", function () {
    // The key's prefix is what `assertKeyOwnership` treats as a security
    // property, so it must not leave the server. `index` is what the download
    // route takes and is all the client needs.
    const entries = res.getBody().items.flatMap((row) => row.items || []);
    const withFiles = entries.filter((e) => e.attachments.length > 0);
    if (withFiles.length > 0) {
      const file = withFiles[0].attachments[0];
      expect(file).to.have.property("index");
      expect(file).to.have.property("filename");
      expect(file).to.not.have.property("key");
    }
  });
}

docs {
  # GET /deal-audits — Deals Pending Service Hand-off (PAC-12)

  Producer Dashboard "Deals Pending Service Hand-off" board (**read only**).

  ## 🔴 One row is one DEAL (PAC-72)

  A row used to be one audit *item*, which is what David asked to replace: a
  bundled Auto + Home sale with six open requirements rendered as six rows with
  six Resolve buttons and could fill the board by itself. Each row now carries
  the deal's whole checklist in `items`, plus a completion percentage — the
  figure that replaced the per-item checkmarks he rejected.

  ⚠ `completionPct` is **`resolvedCount / itemCount`**, not
  `(itemCount - openCount) / itemCount`. `openCount` is `openFailedCount` —
  requirements that *failed* and are still open — so an item that is merely
  `in_progress` counts in neither, and the two figures legitimately disagree
  (on the demo seed, for 13 of 18 audits). `resolvedCount` is deliberately not
  on the row: the board renders a bar, not two numbers.

  **`total` and `totalPages` count deals**, not requirements.

  ## 🔴 What is on the board (PAC-106)

  A deal appears when its audit is **waiting on the producer** — `auditStatus`
  is `Not Submitted` or `Fail` (sent back) — **and** it has at least one item
  for the producer (`producerItemCount > 0`). Sorted by the age of its oldest
  outstanding requirement.

  This replaced `openFailedCount > 0`, which had two faults: a `Pending` audit
  (with the manager) stayed on the producer's board with nothing for them to
  do, and a sent-back card **vanished the moment its last item was resolved**,
  before the producer could click Submit. A card now stays until it is
  submitted, and reads `readyToSubmit: true` once nothing is open.

  ### Only the producer's items

  Each template is either **producer-visible** (Good Student, Prior Insurance,
  Home Inspection, …) or **manager-only** (Correct Sold Date, Quote Recap,
  Drivers Verified, …) — `AuditTemplate.producerVisible`, copied onto every
  item. The board lists, counts and completes over the producer's items only;
  the manager sees the whole checklist on the Deal Audit page
  (**Get Deal Audit Review**).

  The exception: a **manager-only item the manager failed** joins the board
  with `managerOnly: true` and the manager's note — the producer fixes it
  through the sale (*Fix it* → Edit Sold Deal), not by uploading here.

  An audit with **no** producer items never reaches this board: it is
  submitted to the manager automatically when generated
  (`submittedById: null`).

  - **Module:** `deal_audits` (must be enabled for the agency)
  - **Permission:** `deal_audits:read`
  - **Data scope** (enforced in the service layer):
    - `own` → deals whose audit is assigned to the caller **or to a role they
      hold** — the access key moved from `dealAuditItems.producerId` to
      `DealAudit.auditAssignee`. The item keeps `producerId` as provenance
      (who sold it); it is no longer what the board is scoped by.
    - `branch` → audits in the caller's branch (or the `X-Branch-Id` branch)
    - `agency` → all audits in the agency

  ⚠ Reassigning an audit therefore **removes the deal from the previous
  assignee's board** — for an `own`-scoped producer, that means losing sight of
  a deal they sold. See **Set Audit Assignment**.

  ## Query params
  | param    | type | default | rules                              |
  |----------|------|---------|------------------------------------|
  | page     | int  | 1       | min 1 (1-based)                    |
  | pageSize | int  | 8       | min 1, max 50                      |
  | due      | enum | `all`   | `all` \| `overdue` \| `due_soon`    |
  | dealId   | id   | —       | optional — one deal's card only (PAC-106) |

  ### `dealId` — one card (PAC-106)

  What the `audit.sent_back` notification's link
  (`/dashboard/producer?audit=<dealId>`) uses to open the producer's drawer,
  wherever the card sits in the board's paging. The board's rules still apply:
  a deal out of the caller's scope, or no longer waiting on them (`Pending`,
  `Pass`), is an **empty page**, never a 404.

  ### `due` — the soft 7-day deadline (PAC-65)

  ⚠ **A filter, not enforcement.** Generated items carry a `dueAt` of
  `generated + 7 days`. Nothing reads it to change state: no cron, no auto-fail,
  no escalation, no expiry, and no status that flips itself at day 7. An item
  past its `dueAt` is still `in_progress` / failed until a human resolves it.
  The team pulls an overdue list, and that is the whole of it.

  - `all` — adds no clause. Byte-identical to the pre-PAC-65 response.
  - `overdue` — `dueAt < now`.
  - `due_soon` — `dueAt` within the next 3 days.

  Both narrowing values **require `dueAt` to exist**, so items generated before
  the field was added match neither and are never overdue. There is still no
  *backfill* — retro-stamping deadlines onto documents already in Mongo would
  manufacture a backlog nobody agreed to.

  **The SmartSuite import is the exception (PAC-80).** It stamps
  `firstCreatedAt + 7` on the items it writes, because an imported item really
  was raised on that date and really is still open — the deadline is a fact
  being recorded, not one being invented. Without it both narrowing values
  answered *nothing at all* on a migrated agency: every migrated item had a null
  `dueAt`, so every audit's rolled-up `dueAt` was null too, and `?due=overdue`
  returned zero rows against a book with 192 open audits.

  Expect a freshly-migrated agency to start with a large overdue list. That is
  the state of their book, and showing it is what the board is for.

  Since PAC-72 the filter reads the **deal's** rolled-up `dueAt` — the earliest
  deadline across its outstanding requirements. Semantics are unchanged: a deal
  is overdue when its most pressing requirement is.

  ## Headers
  - `Authorization: Bearer <accessToken>` — inherited from the collection.
  - `X-Branch-Id` *(optional)* — disabled by default. Only relevant for
    `branch`/`agency` callers who want to target a specific branch; ignored for
    producers (`own` scope). Enable the header to send it.

  ## Response `200`
  ```json
  {
    "page": 1,
    "pageSize": 8,
    "total": 12,
    "totalPages": 2,
    "items": [
      {
        "id": "665f...9c1",
        "dealId": "665f...a03",
        "ref": "AUD-2026-0042",
        "client": "Jane Homeowner",
        "type": "Home",
        "auditStatus": "Fail",
        "completionPct": 50,
        "itemCount": 2,
        "openCount": 1,
        "readyToSubmit": false,
        "sentBack": {
          "at": "2026-10-19T15:02:00.000Z",
          "byName": "Morgan Manager",
          "note": "The transcript is from 2019.",
          "failedItemCount": 1
        },
        "oldestDaysOpen": 9,
        "dueAt": "2026-08-24T10:15:00.000Z",
        "items": [
          {
            "id": "665f...ac1",
            "missing": "Wind/Hail Inspection Report",
            "daysOpen": 9,
            "open": true,
            "dueAt": "2026-08-24T10:15:00.000Z",
            "attachments": [
              {
                "index": 0,
                "filename": "roof-receipt.pdf",
                "contentType": "application/pdf",
                "size": 20480
              }
            ],
            "requiresUpload": true,
            "managerOnly": false,
            "review": {
              "verdict": "fail",
              "note": "The transcript is from 2019.",
              "reviewedAt": "2026-10-19T15:01:00.000Z",
              "reviewedByName": "Morgan Manager"
            }
          }
        ]
      }
    ]
  }
  ```

  `id` is the **audit** record; `items[].id` is what the resolve, presign and
  download routes take, and `dealId` is what every workflow endpoint is keyed
  on. `items` lists the **whole** checklist, outstanding entries first — the
  settled ones have to be present for "sorted to the top" to mean anything, and
  they render with no checkmark by design.

  Row fields:
  | field    | type   | notes                                                   |
  |----------|--------|---------------------------------------------------------|
  | id       | string | raw record id (opaque; UI shows `ref`)                  |
  | ref      | string | masked, human-readable label `AUD-<year>-<seq>`         |
  | client   | string | client name (`"Unknown Client"` fallback)              |
  | type     | enum   | linked deal type: `Auto` \| `Home` \| `Bundle` \| `Other` |
  | missing  | string | the failed/missing requirement (audit item name)        |
  | daysOpen | number | days the item has been open (oldest first)              |
  | dueAt    | string \| null | soft deadline, ISO. `null` for items generated before the field existed |
  | attachments | array | proofs uploaded at sale time (PAC-56 #21b), surfaced by PAC-65 #16 |
  | requiresUpload | boolean | the producer cannot resolve it without a document (PAC-106) |
  | managerOnly | boolean | a manager-only item on the board because the manager failed it |
  | review | object | the manager's ruling: `{ verdict: "pass" \| "fail" \| null, note, reviewedAt, reviewedByName }` |

  Deal-level since PAC-106: `itemCount`, `openCount` and `completionPct` count
  the **producer's** items only; `readyToSubmit` is `openCount === 0`;
  `sentBack` is `{ at, byName, note, failedItemCount }` while the audit is
  sent back, else `null`.

  ### `attachments` — evidence, or the instruction to go get it

  Producers have been uploading discount proofs since PAC-56 #21b and the board
  never read them, so the service team was chasing documents already sitting in
  storage. Each entry is `{ index, filename, contentType, size }` — **never the
  storage key**, whose prefix is a security property `assertKeyOwnership`
  relies on. Fetch a short-lived URL with
  `GET /deal-audits/:itemId/attachments/:index/download`.

  ⚠ **An empty array is meaningful**, not missing data: it is what makes the row
  read "no document on file — call the client and obtain it". Uploads are
  optional across Card 5 as of PAC-65, so this is the common case.

  ## Errors
  - `401 Unauthorized` — missing/expired access token.
  - `403 Forbidden` — `deal_audits` module disabled, or missing
    `deal_audits:read`, or a branch mismatch for a branch-scoped caller.
  - `400 Bad Request` — invalid query params (e.g. `pageSize` > 50, `page` < 1).

  > **Tip:** the seeded producer (`producer@demoagency.local`) is the
  > data-rich user for this board. Log in as them to get non-empty results.
}
