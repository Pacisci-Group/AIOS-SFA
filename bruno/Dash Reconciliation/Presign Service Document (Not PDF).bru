meta {
  name: Presign Service Document (Not PDF)
  type: http
  seq: 57
}

post {
  url: {{baseUrl}}/carrier-reconciliation/assigned/{{reconRowId}}/documents/presign
  body: json
  auth: bearer
}

auth:bearer {
  token: {{reconSvcCsrToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "filename": "application.png",
    "contentType": "image/png",
    "size": 2048
  }
}

tests {
  test("returns 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  # POST …/documents/presign — not a PDF: 400

  The new business application is a PDF, on a 1-800 policy as on every other.
  The presign refuses anything else up front; the intake checks the stored
  object's type again (`HeadObject`), which is the real gate.
}
