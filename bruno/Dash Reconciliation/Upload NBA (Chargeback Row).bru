}

body:text {
  %PDF-1.4
  1 0 obj<</Type/Catalog>>endobj
  trailer<</Root 1 0 R>>
  %%EOF
}

tests {
  test("storage accepts the application", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

