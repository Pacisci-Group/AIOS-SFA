meta {
  name: Get Assigned Row (Chargeback Done)
  type: http
  seq: 75
}

get {
  url: {{baseUrl}}/carrier-reconciliation/assigned/{{reconAssignRowId}}
  body: none
  auth: inherit
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("the chargeback finished the outcome and decided the row", function () {
    const body = res.getBody();
    expect(body.outcome.kind).to.equal("chargeback");
    expect(body.outcome.status).to.equal("done");
    expect(body.outcome.chargebackId).to.be.a("string");
    expect(body.review.resolution).to.equal("chargeback_recorded");
    expect(body.review.reviewedBy.id).to.equal(bru.getVar("currentUserId"));
  });
}

docs {
  # GET /carrier-reconciliation/assigned/:rowId — after the chargeback

  The finished Chargeback: done, the ledger row linked, the row resolved
  `chargeback_recorded`. It is off the assignee's list; the owner's tabs read
  "Chargeback recorded".
}
