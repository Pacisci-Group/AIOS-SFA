meta {
  name: Create Run (Upload Missing)
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/carrier-reconciliation/runs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{reconToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "storageKey": "agencies/{{reconAgencyId}}/carrier-reconciliation/2026/never-uploaded.xlsx",
    "uploadedFilename": "never-uploaded.xlsx",
    "size": 1000
  }
}

tests {
  test("returns 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("says the file did not land", function () {
    expect(res.getBody().message).to.contain("not found in storage");
  });
}

docs {
  # POST /carrier-reconciliation/runs — a presigned key with nothing uploaded (400)

  `HeadObject` is the only evidence of what landed; a declared size proves
  nothing on its own.
}
