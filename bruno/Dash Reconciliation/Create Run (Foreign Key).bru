meta {
  name: Create Run (Foreign Key)
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/carrier-reconciliation/runs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{reconToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "storageKey": "agencies/000000000000000000000000/carrier-reconciliation/2026/someone-elses.xlsx",
    "uploadedFilename": "someone-elses.xlsx",
    "size": 1000
  }
}

tests {
  test("returns 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  # POST /carrier-reconciliation/runs — a key another agency minted (400)

  The client hands back the key it was given, so the server tests the
  `agencies/<agencyId>/carrier-reconciliation/` prefix before reading — or
  deleting — anything.
}
