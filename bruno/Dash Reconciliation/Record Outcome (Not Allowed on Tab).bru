meta {
  name: Record Outcome (Not Allowed on Tab)
  type: http
  seq: 37
}

patch {
  url: {{baseUrl}}/carrier-reconciliation/assigned/{{reconPremiumRowId}}/outcome
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "kind": "sold"
  }
}

tests {
  test("returns 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("because only a row missing from the app is a sale to book", function () {
    expect(res.getBody().code).to.equal("RECONCILIATION_OUTCOME_NOT_ALLOWED");
  });
}

docs {
  # PATCH …/assigned/:rowId/outcome — Sold on a row not missing from the app (400)

  The outcomes a row can take depend on its tabs
  (`reconciliationOutcomeKinds`): a Dash sale **missing from the app** can be
  Sold, a Cancel rewrite or Other; a row in any other tab — this premium
  difference, a 1-800 line, a policy not in Dash — only Other. The row is
  unchanged.

  ```json
  { "code": "RECONCILIATION_OUTCOME_NOT_ALLOWED",
    "message": "A row in Premium differs cannot be recorded as Sold." }
  ```
}
