meta {
  name: Review Row (Reopen Missing)
  type: http
  seq: 26
}

patch {
  url: {{baseUrl}}/carrier-reconciliation/runs/{{reconRunId}}/rows/{{reconAssignRowId}}/review
  body: json
  auth: bearer
}

auth:bearer {
  token: {{reconToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "open"
  }
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("the row waits on a decision again", function () {
    expect(res.getBody().review.status).to.equal("open");
    expect(res.getBody().review.resolution).to.equal(null);
  });

  test("with nothing recorded on it", function () {
    // The last run left it Chargeback — done (`Cancel Row Policy`), still
    // assigned to the producer (`Assign Row (For Chargeback)`).
    expect(res.getBody().outcome).to.equal(null);
  });
}

docs {
  # PATCH …/review `{ "status": "open" }` — set the fixture row up for assignment

  Only a row still waiting on a decision can be assigned, and on a database
  that already reconciled the fixture (`Create Run` → 409) the row keeps
  whatever someone last did to it — decided on the page, say, or finished as
  a **Chargeback** (`chargeback_recorded`) by the previous run of this folder,
  still assigned to the producer. Reopening it first lets
  the assignment and outcome requests that follow run from the same state
  every time: it is this folder's per-run reset.

  Reopening clears the resolution and the reviewer, and **the assignee's
  outcome**, finished or not (PAC-173 PR 4) — the decision an outcome wrote
  is the one being taken back. It never touches the assignment, and a deal
  the outcome booked stays booked: every run of this folder books the Dash
  line twice more — once by the Sold chain, once by the Chargeback chain
  (PAC-173 PR 6), which leaves its copy cancelled with a chargeback — as new
  leads and deals on the same household.
}
