meta {
  name: Review Row (Resolved Without Resolution)
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/carrier-reconciliation/runs/{{reconRunId}}/rows/{{reconRowId}}/review
  body: json
  auth: bearer
}

auth:bearer {
  token: {{reconToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "resolved"
  }
}

tests {
  test("returns 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  # PATCH …/review — `resolved` needs a resolution (400)

  A resolved row says how it was resolved, so the exception list a manager
  hands on is self-explanatory.
}
