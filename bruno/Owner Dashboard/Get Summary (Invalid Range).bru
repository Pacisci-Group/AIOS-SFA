meta {
  name: Get Summary (Invalid Range)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/owner-dashboard/summary?range=week
  body: none
  auth: bearer
}

params:query {
  range: week
}

auth:bearer {
  token: {{ownerDashboardToken}}
}

tests {
  test("rejects a range that belongs to the producer dashboard", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  # GET /owner-dashboard/summary — a range it does not offer

  `week` is the **producer** dashboard's chip. The owner's reads take the
  management bar's periods (`today` · `yesterday` · `mtd` · `lastMonth` ·
  `last3Months` · `ytd` · `lastYear` · `custom`) and the Analytics page's
  `last12Months`, but not the producer dashboard's.
  Also `400`: `custom` without both bounds, reversed, an impossible date
  (`2026-02-31`), or more than 366 days.
}
