# Production/dev-server environment file — place at /opt/sfa/.env on the droplet.
# NEVER commit the real file. This is only a template.
#
# ⚠ The deploy workflow (.github/workflows/deploy.reusable.yml) REWRITES this
# file in full on every deploy from GitHub Environment secrets. Editing it on the
# droplet is only useful for a manual first bring-up or an emergency rollback —
# for anything lasting, set the secret in the Environment instead.

# Registry image refs (set by the deploy workflow, or manually)
API_IMAGE=ghcr.io/OWNER/REPO/api:latest
WEB_IMAGE=ghcr.io/OWNER/REPO/web:latest

# Host bind for the web container (host Nginx proxies to this)
WEB_BIND=127.0.0.1:8080

# Managed MongoDB connection string (from: terraform output -raw mongodb_uri).
# Must be a replica set — the lead-intake pipeline writes lead + household +
# contacts in a single transaction, which standalone mongod does not support.
# DO Managed MongoDB satisfies this even at node_count = 1. If it ever doesn't,
# the API does not fail: TransactionRunner logs "MongoDB is NOT a replica set"
# and falls back to compensating deletes. Check the boot log after a deploy.
MONGODB_URI=

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Public origin (used for CORS). Same-origin deploy, so this is the site URL.
CORS_ORIGIN=https://dev.example.com

# Base URL used to build shareable public intake links
# (`${PUBLIC_FORM_BASE_URL}/f/lead/{token}`). Unset, the API falls back to
# http://localhost:5173 and every link a producer shares is dead on arrival.
PUBLIC_FORM_BASE_URL=https://dev.example.com

# --- Object storage (DigitalOcean Spaces) ---
# Document uploads for deal-audit resolutions and the intake pipeline. Uploads
# are presigned PUTs sent by the browser straight to the bucket, so the bucket
# also needs CORS rules allowing this site's origin — Terraform provisions those
# (modules/spaces). Values come from the environment's terraform outputs:
#   spaces_endpoint, spaces_region, spaces_bucket,
#   spaces_access_key_id, spaces_secret_access_key
#
# ⚠ If STORAGE_ENDPOINT is empty the API logs a warning, disables storage, and
# still passes its health check — uploads fail with no other signal.
STORAGE_ENDPOINT=https://nyc3.digitaloceanspaces.com
STORAGE_REGION=nyc3
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Spaces uses virtual-host addressing; only MinIO (local dev) needs path-style.
STORAGE_FORCE_PATH_STYLE=false
# STORAGE_PUBLIC_URL is only needed when the API and the browser reach storage at
# different addresses (the local MinIO minio:9000 vs localhost:9100 split).
# Leave unset in the cloud.
# Presigned URL lifetimes (seconds).
# STORAGE_UPLOAD_URL_TTL_SECONDS=300
# STORAGE_DOWNLOAD_URL_TTL_SECONDS=300

# --- Rate limiting for the public intake routes (optional) ---
# Defaults live in packages/api/src/config/rate-limit.config.ts. These must be
# REAL environment variables — compose's env_file makes them exactly that. A
# value placed in a dotenv file the app loads itself would be ignored, because
# the @Throttle decorators evaluate before ConfigModule runs.
# RATE_LIMIT_SHORT=300
# RATE_LIMIT_LONG=3000
# PUBLIC_FORM_RATE_LIMIT=10
# PUBLIC_INTAKE_RATE_LIMIT=5
# PUBLIC_INTAKE_HOURLY_LIMIT=30

# Seed credentials — used only for the one-time manual seed run.
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=
SEED_AGENCY_OWNER_EMAIL=owner@example.com
SEED_AGENCY_OWNER_PASSWORD=
