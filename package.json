    "api:start": "npm run start:prod -w @sfa/api",
    "api:seed": "npm run seed -w @sfa/api",
    "api:seed:dev": "npm run seed:dev -w @sfa/api",
    "api:seed:demo": "npm run seed:demo -w @sfa/api",
    "api:seed:demo:dev": "npm run seed:demo:dev -w @sfa/api",
    "api:migrate": "npm run migrate -w @sfa/api",
    "api:migrate:dev": "npm run migrate:dev -w @sfa/api",
    "api:backfill:deal-refs": "npm run backfill:deal-refs -w @sfa/api",
    "api:backfill:deal-refs:dev": "npm run backfill:deal-refs:dev -w @sfa/api",
    "api:fix:dedupe-indexes": "npm run fix:dedupe-indexes -w @sfa/api",
