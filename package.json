{
  "name": "sfa-apps",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run dev -w @sfa/api",
    "api:build": "npm run build -w @sfa/api",
    "api:start": "npm run start:prod -w @sfa/api",
    "worker:dev": "npm run worker:dev -w @sfa/api",
    "api:seed": "npm run seed -w @sfa/api",
    "api:seed:dev": "npm run seed:dev -w @sfa/api",
    "api:seed:demo": "npm run seed:demo -w @sfa/api",
    "api:seed:demo:dev": "npm run seed:demo:dev -w @sfa/api",
    "api:migrate": "npm run migrate -w @sfa/api",
    "api:migrate:dev": "npm run migrate:dev -w @sfa/api",
    "api:migrate:mailers": "npm run migrate:mailers -w @sfa/api",
    "api:migrate:mailers:dev": "npm run migrate:mailers:dev -w @sfa/api",
    "api:migrate:tickets": "npm run migrate:tickets -w @sfa/api",
    "api:migrate:tickets:dev": "npm run migrate:tickets:dev -w @sfa/api",
    "api:sync:roles": "npm run sync:roles -w @sfa/api",
    "api:sync:roles:dev": "npm run sync:roles:dev -w @sfa/api",
    "web:dev": "npm run dev -w @sfa/web",
    "web:build": "npm run build -w @sfa/web",
    "web:preview": "npm run preview -w @sfa/web",
    "shared:build": "npm run build -w @sfa/shared",
    "dev": "npm run api:dev",
    "test:e2e": "npm run test:e2e -w @sfa/api",
    "docker:infra": "docker compose --profile app stop api web; docker compose up -d",
    "docker:infra:down": "docker compose stop mongo minio redis",
    "docker:up": "docker compose --profile app up --build -d",
    "docker:down": "docker compose --profile app down"
  },
  "engines": {
    "node": ">=20"
  }
}
